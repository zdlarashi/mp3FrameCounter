{
  "name": "mp3framecounter",
  "version": "1.0.0",
  "description": "API that returns the frame count in an mp3 file",
  "private": true,
  "type": "module",
  "author": "Zakk Lambertsen",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zdlarashi/mp3FrameCounter.git"
  },
  "bugs": {
    "url": "https://github.com/zdlarashi/mp3FrameCounter/issues"
  },
  "homepage": "https://github.com/zdlarashi/mp3FrameCounter#readme",
  "keywords": [],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "fixtures:generate": "./scripts/generate-fixtures.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "fastify": "^5.12.5"
  }
}
